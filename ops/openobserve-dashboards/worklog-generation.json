        {
          "id": "t_all",
          "type": "table",
          "title": "All generations — newest first",
          "description": "One row per Generate call. 'When (local)' = when the call ran; 'Result' = matched an existing task vs proposed a new one; 'Candidates' = tasks the model chose among. Click a row to open its full trace tree (the llm.call spans with input/prompt/output, and the matched task key on the worklog.generate span).",
          "config": {
            "show_legends": false,
            "wrap_table_cells": false,
            "drilldown": [
              {
                "name": "Open this trace's spans",
                "type": "byUrl",
                "targetBlank": true,
                "findBy": "name",
                "data": {
                  "url": "/web/traces?org_identifier=default&stream=default&search_type=ui&search_mode=spans&period=30d&query=${row.field.trace_filter}",
                  "folder": "",
                  "dashboard": "",
                  "tab": "",
                  "passAllVariables": false,
                  "variables": []
                }
              }
            ]
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT\n  to_char(to_timestamp_micros(_timestamp + 19800000000),'%Y-%m-%d %H:%M') as \"When (local)\",\n  llm_provider as \"Provider\",\n  CASE WHEN proposed='true' THEN 'proposed new task' ELSE 'matched existing' END as \"Result\",\n  CAST(n_candidates AS BIGINT) as \"Candidates\",\n  round(CAST(duration AS DOUBLE)/1000000,1) as \"Elapsed (s)\",\n  trace_id,\n  encode(concat('trace_id=''', trace_id, ''''),'base64') as trace_filter\nFROM \"default\" WHERE operation_name='worklog.generate' ORDER BY _timestamp DESC",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "When (local)",
                    "alias": "When (local)",
                    "column": "When (local)",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Provider",
                    "alias": "Provider",
                    "column": "Provider",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Result",
                    "alias": "Result",
                    "column": "Result",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Candidates",
                    "alias": "Candidates",
                    "column": "Candidates",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Elapsed (s)",
                    "alias": "Elapsed (s)",
                    "column": "Elapsed (s)",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "trace_id",
                    "alias": "trace_id",
                    "column": "trace_id",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "trace_filter",
                    "alias": "trace_filter",
                    "column": "trace_filter",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "y": [],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1.0
              }
            }
          ],
          "layout": {
