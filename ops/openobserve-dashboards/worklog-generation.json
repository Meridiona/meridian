{
  "version": 8,
  "title": "Worklog Generation",
  "description": "The on-demand 'Generate worklog' call from a day-task card: one centralised LLM call (span `worklog.generate`, service meridian-rust) matches a workstream against the tracker's non-terminal tasks (or proposes a new one) and drafts a high-level status update; `worklog.generate.approve` posts it. `proposed` = whether a new task was proposed (vs matched an existing one; the matched task key is the `matched_task_key` span attribute), `n_candidates` = how many tasks the model chose among, `llm_provider` = who served the call. Each row's full trace carries the llm.request(prompt+input)/llm.response(output) subspans. Click a row for the trace.",
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "m_total",
          "type": "metric",
          "title": "Worklogs generated",
          "description": "Total worklog.generate spans in range",
          "config": {
            "show_legends": false,
            "no_value_replacement": "0",
            "decimals": 0.0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT count(*) as y_axis_1 FROM \"default\" WHERE operation_name='worklog.generate'",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [
                  {
                    "label": "Worklogs generated",
                    "alias": "y_axis_1",
                    "column": "y_axis_1",
                    "color": "#5960b2",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1.0
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 48,
            "h": 18,
            "i": 1
          }
        },
