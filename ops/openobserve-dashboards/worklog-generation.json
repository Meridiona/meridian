          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) as x_axis_1, round(avg(CAST(duration AS DOUBLE)/1000000),1) as y_axis_1 FROM \"default\" WHERE operation_name='worklog.generate' GROUP BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
