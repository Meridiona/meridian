        {
          "id": "m_fallback",
          "type": "metric",
          "title": "Fallback rate %",
          "description": "Share of generations where the model produced NO usable panel and the deterministic set was substituted. This is the feature's report card: raw Vega-Lite emission was chosen over a constrained schema, and this number is what says whether that holds.",
          "config": {
            "show_legends": false,
            "no_value_replacement": "0",
            "decimals": 1.0,
            "unit": "percent"
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT (count(*) FILTER (WHERE fallback='true') * 100.0 / count(*)) as y_axis_1 FROM \"default\" WHERE operation_name='day_summary.generate'",
