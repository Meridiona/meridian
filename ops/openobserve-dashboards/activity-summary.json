              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1.0
              }
            }
          ],
          "layout": {
            "x": 144,
            "y": 0,
            "w": 48,
            "h": 18,
            "i": 4
          }
        },
        {
          "id": "t_all",
          "type": "table",
          "title": "All runs — newest first",
          "description": "One row per hour. 'When (local)' = when the call ran; 'Hour (local)' = the hour it covers. Click a row to open its full trace tree (the per-call llm.call spans with input/prompt/output).",
          "config": {
            "show_legends": false,
            "wrap_table_cells": false,
            "drilldown": [
              {
                "name": "Open this trace's spans",
                "type": "byUrl",
                "targetBlank": true,
                "findBy": "name",
                "data": {
                  "url": "/web/traces?org_identifier=default&stream=default&search_type=ui&search_mode=spans&period=30d&query=${row.field.trace_filter}",
                  "folder": "",
                  "dashboard": "",
                  "tab": "",
                  "passAllVariables": false,
                  "variables": []
                }
              }
            ]
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT\n  to_char(to_timestamp_micros(_timestamp + 19800000000),'%Y-%m-%d %H:%M') as \"When (local)\",\n  concat(substr(hour,1,10),' ',substr(hour,12,2),':00-',lpad(CAST((CAST(substr(hour,12,2) AS BIGINT)+1)%24 AS VARCHAR),2,'0'),':00') as \"Hour (local)\",\n  llm_provider as \"Provider\",\n  CAST(n_calls AS BIGINT) as \"Calls\",\n  CAST(n_activities AS BIGINT) as \"Activities\",\n  round(CAST(duration AS DOUBLE)/1000000,1) as \"Elapsed (s)\",\n  trace_id,\n  encode(concat('trace_id=''', trace_id, ''''),'base64') as trace_filter\nFROM \"default\" WHERE operation_name='worklog.report' AND hour IS NOT NULL AND length(hour) >= 13 ORDER BY _timestamp DESC",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "When (local)",
                    "alias": "When (local)",
                    "column": "When (local)",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Hour (local)",
                    "alias": "Hour (local)",
                    "column": "Hour (local)",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Provider",
                    "alias": "Provider",
                    "column": "Provider",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Calls",
                    "alias": "Calls",
                    "column": "Calls",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Activities",
                    "alias": "Activities",
                    "column": "Activities",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "Elapsed (s)",
                    "alias": "Elapsed (s)",
                    "column": "Elapsed (s)",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "trace_id",
                    "alias": "trace_id",
                    "column": "trace_id",
                    "isDerived": false,
                    "havingConditions": []
                  },
                  {
                    "label": "trace_filter",
                    "alias": "trace_filter",
                    "column": "trace_filter",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "y": [],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1.0
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 18,
            "w": 192,
            "h": 42,
            "i": 9
          }
        }
      ]
