{
  "version": 8,
  "title": "Activity Summary",
  "description": "The hourly activity summary + time estimate, Rust-owned (span `worklog.report`, service meridian-rust). One row per hour: 'When (local)' is when the call ran, 'Hour (local)' is the hour of the day it summarised, 'Calls' is 1 or 2 (activity-summary always runs; activity-time runs only when there are activities against a measured timeline). CLICK A ROW -> the trace shows the `worklog.report` span with its `llm.call` children (one per call), each carrying the exact `llm_prompt` (system prompt), `llm_input` (what was sent) and `llm_output` (the model's answer), plus provider, tokens and elapsed.",
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "m_total",
          "type": "metric",
          "title": "Hours summarised",
          "description": "Total worklog.report spans in range",
          "config": {
            "show_legends": false,
            "no_value_replacement": "0",
            "decimals": 0.0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT count(*) as y_axis_1 FROM \"default\" WHERE operation_name='worklog.report'",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [
                  {
                    "label": "Hours summarised",
                    "alias": "y_axis_1",
                    "column": "y_axis_1",
                    "color": "#5960b2",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1.0
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 48,
            "h": 18,
            "i": 1
          }
        },
        {
          "id": "m_avg",
          "type": "metric",
          "title": "Avg activities",
          "description": "Mean activities parsed per hour",
          "config": {
            "show_legends": false,
            "no_value_replacement": "0",
            "decimals": 1.0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) as x_axis_1, round(avg(CAST(n_activities AS DOUBLE)),1) as y_axis_1 FROM \"default\" WHERE operation_name='worklog.report' AND n_activities IS NOT NULL GROUP BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [
                  {
                    "label": "Avg activities",
                    "alias": "y_axis_1",
                    "column": "y_axis_1",
                    "color": "#59b27a",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1.0
              }
            }
          ],
          "layout": {
            "x": 48,
            "y": 0,
            "w": 48,
            "h": 18,
            "i": 2
          }
        },
        {
          "id": "m_elapsed",
          "type": "metric",
          "title": "Avg elapsed (s)",
          "description": "Mean span wall-clock",
          "config": {
            "show_legends": false,
            "no_value_replacement": "0",
            "decimals": 1.0,
            "unit": "seconds"
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) as x_axis_1, round(avg(CAST(duration AS DOUBLE)/1000000),1) as y_axis_1 FROM \"default\" WHERE operation_name='worklog.report' GROUP BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [
                  {
                    "label": "Avg elapsed (s)",
                    "alias": "y_axis_1",
                    "column": "y_axis_1",
                    "color": "#59a0b2",
                    "isDerived": false,
                    "havingConditions": []
                  }
                ],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1.0
              }
            }
          ],
          "layout": {
            "x": 96,
            "y": 0,
            "w": 48,
            "h": 18,
            "i": 3
