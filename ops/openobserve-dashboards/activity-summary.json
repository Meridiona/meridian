        },
        {
          "id": "m_providers",
          "type": "metric",
          "title": "Distinct providers",
          "description": "How many LLM providers served this stage",
          "config": {
            "show_legends": false,
            "no_value_replacement": "0",
            "decimals": 0.0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT count(DISTINCT llm_provider) as y_axis_1 FROM \"default\" WHERE operation_name='worklog.report' AND llm_provider IS NOT NULL",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [
                  {
                    "label": "Distinct providers",
                    "alias": "y_axis_1",
