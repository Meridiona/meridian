# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).

# ── Container images (pin to versions you've validated) ──────────────────────
# Keep OO_IMAGE's version aligned with scripts/install-openobserve-daemon.sh so
# the central instance and a developer's local instance behave identically.
OO_IMAGE=public.ecr.aws/zinclabs/openobserve:v0.90.3
COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
# Pinned like the other two: `caddy:2` is a mutable major tag, so a redeploy
# could silently pull a new minor into the TLS/basic-auth front door. Bump this
# deliberately after validating, rather than discovering the change during an
# unrelated deploy. NOTE: this template does not touch a VM's existing `.env`
# (scripts/deploy-gateway.sh never copies it), so update the live `.env` by hand
# to adopt the pin - check the running version first with
# `docker compose exec caddy caddy version`.
#
# 2.11.4 is the current 2.x at time of pinning, so this should be a no-op for
# the running instance (which was on the floating `caddy:2`). Pinning to an
# older release would have been worse than not pinning: this container
# terminates TLS for the whole gateway.
CADDY_IMAGE=caddy:2.11.4

# ── OpenObserve root credentials — SERVER-SIDE ONLY, never shipped to installs ─
OO_ROOT_USER_EMAIL=admin@meridiona.com
OO_ROOT_USER_PASSWORD=change-me-to-a-long-random-secret
# OpenObserve organisation the streams live under (default org is "default").
OO_ORG=default
# Days of telemetry to keep before OpenObserve auto-deletes it. Its own default
# is 3650 (ten years) — far past the point a modest boot disk fills, and a full
# disk surfaces as confusing ingest failures rather than as "disk full".
# 90 days is long enough to see a regression trend across a few releases.
# Minimum accepted by OpenObserve is 3.
OO_RETENTION_DAYS=90

# ── Distributable write-only ingest token (baked into the DMG at release) ─────
# This is the ONLY credential an install carries. It is write-scoped by virtue
# of the gateway (installs can POST OTLP but cannot read anything). Generate a
# fresh one with:  openssl rand -hex 32
# Rotate any time: change this, `docker compose up -d`, ship the new token in
# the next release. Old token stops working immediately.
INGEST_TOKEN=change-me-openssl-rand-hex-32

# ── Public domains (Caddy provisions Let's Encrypt TLS for each) ─────────────
# DNS A-records for both must point at this VM before first `docker compose up`.
GATEWAY_DOMAIN=telemetry.meridiona.com
OO_UI_DOMAIN=observe.meridiona.com

# ── Caddy basic auth in front of the OpenObserve UI ──────────────────────────
# The outer of the UI's two credential layers (see the Caddyfile). Applies to
# OO_UI_DOMAIN only — the ingest gateway must stay basic-auth-free or every
# install's Bearer request would be challenged.
#
# Generate the hash (bcrypt — never put a plaintext password here):
#   docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
#
# !! ESCAPE EVERY `$` IN THE HASH AS `$$` BEFORE PASTING IT BELOW !!
# Docker Compose interpolates `$` inside .env values, so a raw bcrypt hash is
# silently TRUNCATED at its first field (`$2a$14$abc…` arrives as `$2a$14`) and
# every UI login fails with no useful error. `env_file:` mangles it the same
# way — escaping is the fix. Mechanically:
#   docker run --rm caddy:2 caddy hash-password --plaintext '<password>' \
#     | sed 's/\$/$$/g'
# Verify after editing: `docker compose config | grep OO_UI_PASSWORD_HASH`
# must show the FULL hash (rendered with doubled `$`, which is correct — that
# is how compose escapes a literal `$` in its own output format).
OO_UI_USER=meridiona
OO_UI_PASSWORD_HASH=$$2a$$14$$replace-with-escaped-bcrypt-hash
