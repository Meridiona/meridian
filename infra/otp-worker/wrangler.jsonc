{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // First live Cloudflare Worker in this repo (infra/hf-proxy, the prior one,
  // was deleted after shipping unauthenticated with no rate limit and taking
  // the whole Cloudflare account down — see README.md "Why this design"
  // before changing anything auth- or rate-limit-related here).
  "name": "meridian-otp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // ── KV namespace ──────────────────────────────────────────────────────────
  // A human must run `wrangler kv namespace create OTP_KV` (and again with
  // `--env staging`) and paste the returned ids below before this can be
  // deployed for real. See README.md "Manual steps before first deploy".
  "kv_namespaces": [
    {
      "binding": "OTP_KV",
      "id": "417585461d7e4f3b9a87d87da44e2002"
    }
  ],

  // ── Non-secret tunables ───────────────────────────────────────────────────
  // Real credentials (OTP_CLIENT_TOKEN, OTP_CODE_PEPPER, AWS_*, CI_TEST_TOKEN)
  // are `wrangler secret put` ONLY — never here. See README.md's secrets table.
  "vars": {
    // Distinguishes prod from staging inside the Worker without relying on an
    // unset-vs-set secret (the staging-only code-echo path checks this
    // explicitly: `env.ENVIRONMENT !== "staging"` short-circuits it even if a
    // CI_TEST_TOKEN secret were ever mistakenly set on the production
    // environment).
    "ENVIRONMENT": "production",
    "FROM_ADDRESS": "otp@auth.meridiona.com",
    "FROM_NAME": "Meridian",
    "OTP_TTL_S": 600,
    "MAX_VERIFY_ATTEMPTS": 5,
    "RL_EMAIL_PER_DAY": 3,
    "RL_IP_PER_HOUR": 10,
    "RL_GLOBAL_PER_DAY": 2000,
    // Fires one alert email (via the same SES setup, see ses.ts's
    // sendRateLimitAlertEmail) the first time the GLOBAL daily counter
    // crosses this percentage of RL_GLOBAL_PER_DAY — a KV flag
    // (alert:sent:<date>) makes it a once-per-UTC-day event, not once per
    // request past the threshold. Deliberately scoped to the global counter
    // only: per-email/per-IP caps tripping is routine abuse-prevention
    // noise, not something worth an alert.
    "ALERT_THRESHOLD_PCT": 80,
    "ALERT_EMAIL": "akarsh@meridiona.com",
    // Fires once per successful /otp/verify (sign-up or a changed email) —
    // see ses.ts's sendAccountEventEmail. Unlike ALERT_EMAIL this has no
    // once-per-day dedup: every verify here is a genuine one-time capture or
    // a deliberate "Change email" action, never a routine re-login (this app
    // has no session/sign-in-again concept), so there's no repeat-noise case
    // to suppress.
    "NOTIFY_EMAIL": "company@meridiona.com"
  },

  "env": {
    "staging": {
      "name": "meridian-otp-worker-staging",
      "kv_namespaces": [
        {
          "binding": "OTP_KV",
          "id": "72989398df1646979ed8f7ce0961f3b1"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "FROM_ADDRESS": "otp@auth.meridiona.com",
        "FROM_NAME": "Meridian (staging)",
        "OTP_TTL_S": 600,
        "MAX_VERIFY_ATTEMPTS": 5,
        // RL_IP_PER_HOUR is deliberately HIGHER here than the per-email cap
        // needs, not lower — scripts/deploy-otp-worker.sh's probes (the
        // rate-limit-trip probe, which sends RL_EMAIL_PER_DAY+1 requests from
        // one IP, plus the happy-path send) burn several units of per-IP
        // budget from a single source IP on every run. A cap sized close to
        // RL_EMAIL_PER_DAY (as an earlier version of this file had it, at 5)
        // means a SECOND `--verify-only` run against the same staging
        // deployment within the hour trips the IP cap on the happy-path send
        // and fails with a misleading "happy-path send -> 429" — reading as a
        // regression rather than the smoke test having rate-limited itself.
        // Sized well above one run's worst-case spend so re-running the
        // script repeatedly while debugging a real failure doesn't itself
        // become a source of failures.
        "RL_EMAIL_PER_DAY": 3,
        "RL_IP_PER_HOUR": 30,
        "RL_GLOBAL_PER_DAY": 500,
        "ALERT_THRESHOLD_PCT": 80,
        "ALERT_EMAIL": "akarsh@meridiona.com",
        "NOTIFY_EMAIL": "company@meridiona.com"
      }
    }
  }
}
