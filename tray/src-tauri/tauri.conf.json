{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meridian",
  "version": "1.71.0",
  "identifier": "com.meridiona.tray",
  "build": {
    "frontendDist": "../../ui/out",
    "devUrl": "http://localhost:3939",
    "beforeDevCommand": "rm -rf ../ui/public/popover && mkdir -p ../ui/public/popover && cp -r src/. ../ui/public/popover && cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.meridian/icon-cache/*"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Meridian",
        "url": "popover/index.html",
        "width": 344,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": true,
        "focus": false,
        "zoomHotkeysEnabled": true
      },
      {
        "label": "tray-tooltip",
        "title": "Meridian",
        "url": "popover/tooltip.html",
        "width": 300,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": false,
        "focus": false,
        "zoomHotkeysEnabled": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxQjhDQUE5MTQ1MUE5QzcKUldUSHFWRVVxY3E0UWFmckM3MTNCSmVDYTlabFVZMjdZMjRIZUY3RlhiZlRUV3djTnVPcC9qOFUK",
      "endpoints": [
        "https://github.com/Meridiona/meridian/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "resources": {
      "../../target/release/meridian": "backend/meridian",
      "../../scripts/com.meridiona.daemon.plist": "backend/com.meridiona.daemon.plist"
    }
  }
}
