{
  "branches": [
    {
      "name": "main",
      "prerelease": "rc"
    }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "revert",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "🚀 Features"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "perf",
              "section": "⚡ Performance"
            },
            {
              "type": "refactor",
              "section": "♻️ Refactoring"
            },
            {
              "type": "build",
              "section": "📦 Build System"
            },
            {
              "type": "ci",
              "section": "🤖 CI"
            },
            {
              "type": "test",
              "section": "✅ Tests"
            },
            {
              "type": "docs",
              "section": "📝 Documentation"
            },
            {
              "type": "style",
              "section": "🎨 Styles"
            },
            {
              "type": "chore",
              "section": "🔧 Chores"
            },
            {
              "type": "revert",
              "section": "⏪ Reverts"
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "draftRelease": true
      }
    ]
  ]
}
