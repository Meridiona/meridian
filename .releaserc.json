{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "\ud83d\ude80 Features"
            },
            {
              "type": "fix",
              "section": "\ud83d\udc1b Bug Fixes"
            },
            {
              "type": "perf",
              "section": "\u26a1 Performance"
            },
            {
              "type": "refactor",
              "section": "\u267b\ufe0f Refactoring"
            },
            {
              "type": "build",
              "section": "\ud83d\udce6 Build System"
            },
            {
              "type": "ci",
              "section": "\ud83e\udd16 CI"
            },
            {
              "type": "test",
              "section": "\u2705 Tests"
            },
            {
              "type": "docs",
              "section": "\ud83d\udcdd Documentation"
            },
            {
              "type": "style",
              "section": "\ud83c\udfa8 Styles"
            },
            {
              "type": "chore",
              "section": "\ud83d\udd27 Chores"
            },
            {
              "type": "revert",
              "section": "\u23ea Reverts"
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "draftRelease": true
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "Cargo.toml",
          "Cargo.lock",
          "ui/package.json",
          "packages/meridian-mcp/package.json",
          "tray/src-tauri/tauri.conf.json"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ]
  ]
}
