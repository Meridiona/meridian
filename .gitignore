# Generated by Cargo
debug
/target

# Release assets staged for the GitHub Release — CI artifacts
/release-assets/
meridian.db
meridian.db-shm
meridian.db-wal
.env
.env.local
.env.*.local

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Cargo local config — ignore cache but track config.toml
.cargo/*
!.cargo/config.toml

# AI tooling metadata
.claude-flow/
.agents/*
claude-flow.config.json
# Claude Code
.claude/worktrees/
.claude/*.local* # local changes are specific to the individual developer, let's not check them in for everyone.
.claude/*.lock
.claude/memory.db
.claude/settings.json

# Repo-local runtime settings (hot-reloaded by the daemon, written by the UI) —
# user/machine specific, must never be committed.
/settings.json

ruvector.db
.mcp.json

# deepeval CLI cache (auto-written by `deepeval test run` / `deepeval login`)
.deepeval/
.deepeval-cache.json
.deepeval_telemetry.txt
.latest_test_run.json
.latest_run_full.json

# Python bytecode — the Python stack is gone, but scripts/ still ships a few
# stdlib-only helpers (compose-updater-manifest.py, sync-oo-dashboards.py).
__pycache__/
*.pyc
dist/

# root release-tooling deps
/node_modules/

.DS_Store
ui/data/

# /design-sync export build artifact (node_modules, dist, caches) — the design
# system spec itself lives in the tracked ui/STYLESHEET.md, not here.
packages/meridian-design-system/
